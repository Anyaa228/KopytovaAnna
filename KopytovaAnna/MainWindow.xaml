<Window x:Class="KopytovaAnna.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Калькулятор Копытовой Анны" Height="450" Width="350"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="DisplayBox" Grid.Row="0" Height="60" FontSize="28"
                 HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                 IsReadOnly="True" Text="0" Margin="0,0,0,10"/>

        <UniformGrid Grid.Row="1" Columns="4">
            <Button Content="7" FontSize="22" Margin="3" Click="Digit_Click"/>
            <Button Content="8" FontSize="22" Margin="3" Click="Digit_Click"/>
            <Button Content="9" FontSize="22" Margin="3" Click="Digit_Click"/>
            <Button Content="/" FontSize="22" Margin="3" Click="Op_Click" Tag="/"/>

            <Button Content="4" FontSize="22" Margin="3" Click="Digit_Click"/>
            <Button Content="5" FontSize="22" Margin="3" Click="Digit_Click"/>
            <Button Content="6" FontSize="22" Margin="3" Click="Digit_Click"/>
            <Button Content="*" FontSize="22" Margin="3" Click="Op_Click" Tag="*"/>

            <Button Content="1" FontSize="22" Margin="3" Click="Digit_Click"/>
            <Button Content="2" FontSize="22" Margin="3" Click="Digit_Click"/>
            <Button Content="3" FontSize="22" Margin="3" Click="Digit_Click"/>
            <Button Content="-" FontSize="22" Margin="3" Click="Op_Click" Tag="-"/>

            <Button Content="C" FontSize="22" Margin="3" Click="Clear_Click"/>
            <Button Content="0" FontSize="22" Margin="3" Click="Digit_Click"/>
            <Button Content="=" FontSize="22" Margin="3" Click="Equals_Click"/>
            <Button Content="+" FontSize="22" Margin="3" Click="Op_Click" Tag="+"/>
        </UniformGrid>
    </Grid>
</Window>